DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grabmyseats?schema=public"
PORT=4000
# "escrow" (default) is the full reserve -> pay -> check-in -> confirm-
# receipt -> payout flow. "contact_only" instead hands the buyer the
# seller's contact info immediately on reserve and disables /pay,
# /check-in, /confirm-receipt, and the payout-release cron - see
# src/lib/config.ts. Read once at process startup; changing it requires a
# restart.
PAYMENT_MODE="escrow"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Separate secret from AUTH_SECRET above - see lib/adminAuthConfig.ts. Must
# be different from AUTH_SECRET so a customer session can never decode as
# an admin one or vice versa.
ADMIN_AUTH_SECRET="replace-with-a-different-random-32-byte-secret"
# Only read by `npm run seed:admin` (backend/scripts/seedAdmin.ts), a
# one-off script to create the very first ADMIN account - not read by the
# running server. Unset these once the account exists; there's no harm in
# leaving them, but they're not needed again.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
# Comma-separated if more than one origin needs to be allowed (see the
# parsing in src/app.ts) - both the apex domain and "www" are listed here
# since browsers treat them as different origins for CORS purposes.
FRONTEND_ORIGIN="https://grabmyseats.com,https://www.grabmyseats.com"
REDIS_URL="redis://localhost:6379"
# DEV-ONLY: when set (and NODE_ENV != production), submitting this code to
# /api/auth/otp/verify skips the real OTP check. Leave unset in production -
# index.ts refuses to start if NODE_ENV=production and this is set at all.
DEV_OTP_BYPASS_CODE="000000"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-your-razorpay-webhook-secret"
