NEXT_PUBLIC_API_URL=http://localhost:4000
# Read by capacitor.config.ts (Capacitor CLI/native build only, never
# bundled into client JS) - what the native app's WebView loads on
# launch. Unset = defaults to the deployed production frontend. Set this
# to point a native build at a local `next dev` instead: the iOS
# Simulator can use http://localhost:3000 as-is, but the Android Emulator
# needs http://10.0.2.2:3000, and a physical device needs your machine's
# LAN IP (e.g. http://192.168.1.5:3000) - same reasoning as
# NEXT_PUBLIC_API_URL above.
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
