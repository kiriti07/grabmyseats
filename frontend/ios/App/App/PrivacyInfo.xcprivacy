<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest. Data types mirror docs/play-store/data-safety.md
  section 4 (and docs/ios-release.md section 5): all linked to the account,
  none used for tracking, all for app functionality (which, in Apple's
  definition, includes fraud prevention and security). The app's own code
  uses no required-reason APIs; Capacitor and the plugins ship their own
  manifests. Update this and data-safety.md together.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
